# Local development: SQLite file
DATABASE_URL="file:./sqlite.db"

# Production: Turso (Vercel). TURSO_DATABASE_URL wins over DATABASE_URL.
# Create a database with `turso db create` then load its credentials.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
UPLOADTHING_TOKEN=""

# PostHog analytics. Leave the token empty to disable analytics locally.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Realtime (meetings and calls)
# Cloudflare Worker in the cloud-workspace-realtime repo.
WS_AUTH_SECRET="replace-me-with-a-long-random-string"
NEXT_PUBLIC_REALTIME_URL="wss://cloud-workspace-realtime.samarth07nagar.workers.dev"

# Legacy Socket.IO chat service.
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Keep false in production unless a dedicated demo workspace is configured.
ALLOW_PUBLIC_PREVIEW="false"

# Optional LAN origins for `next dev`.
NEXT_ALLOWED_DEV_ORIGINS=""
